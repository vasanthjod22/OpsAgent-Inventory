# OpsAgent Backend — environment variables
# Copy this file to .env and fill in your values.

PORT=3001

# Change this to a strong random string in production!
JWT_SECRET=opsagent_change_me_in_production

# Groq AI API key — get one free at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# The URL of your deployed frontend (used for CORS)
FRONTEND_URL=http://localhost:5173
